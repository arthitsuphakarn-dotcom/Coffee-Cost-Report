[Unit]
Description=Coffee Cost Report (Next.js)
Documentation=https://github.com/arthitsuphakarn-dotcom/Coffee-Cost-Report
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/coffee-cost-report

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=TZ=Asia/Bangkok

# DB credentials live in .env.local (chmod 600, owned by www-data).
# Next.js loads it automatically from WorkingDirectory.

ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=coffee-cost-report

# Hardening: the app only needs to write to ./data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/coffee-cost-report/data

[Install]
WantedBy=multi-user.target
