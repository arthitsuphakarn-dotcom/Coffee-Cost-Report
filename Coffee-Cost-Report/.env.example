# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_cost_report
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Optional single-string connection URL.
# URL-encode special characters in DB_USER or DB_PASSWORD.
# DATABASE_URL=mysql://your_mysql_user:your_mysql_password@localhost:3306/coffee_cost_report
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ตาราง MB51 และ plant ที่รายงานครอบคลุม (ค่า default อยู่ใน lib/database/mb51Repository.ts)
# DB_MB51_TABLE=mb51
# DB_MB51_PLANT=0328

# Production runtime (set by systemd, listed here for reference)
# PORT=3000
# TZ=Asia/Bangkok
